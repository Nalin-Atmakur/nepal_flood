# ── Personal-data firewall ──────────────────────────────────────────
# This repo must never carry personal data. Block every format that
# commonly does. Err toward over-blocking; force-add only after review
# confirming a file is synthetic or aggregate-only.
*.csv
*.tsv
*.xlsx
*.xls
*.sqlite
*.sqlite3
*.db
*.mdb
*.parquet
*.vcf
data/raw/
data/**/*.json
*.kml
*.kmz
*.gpx

# Credentials & secrets
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519
credentials*
secrets*
token*
*.p12

# Bulky binaries that belong in object storage, not git
*.tif
*.tiff
*.jp2
*.img
*.zip
*.tar.gz
*.7z

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
__pycache__/
*.pyc

# Topographic-change automation: local secrets, browser state, caches, and bulk products
.firecrawl/
topographic_change_map/.work/
topographic_change_map/private/
topographic_change_map/node_modules/
topographic_change_map/dist/
topographic_change_map/downloads/
topographic_change_map/artifacts/
topographic_change_map/automation-profile/
topographic_change_map/reports/private/
topographic_change_map/viewer/dist/

# data_aggregator raw pulls
data_aggregator/snapshots/

# data_aggregator — local state, venvs, build output (never commit)
data_aggregator/pipeline/.venv/
data_aggregator/pipeline/_state.json
data_aggregator/pipeline/run.log
data_aggregator/pipeline/snapshots/*
!data_aggregator/pipeline/snapshots/.gitkeep
data_aggregator/gazetteer/.cache/
data_aggregator/web/node_modules/
data_aggregator/web/.next/
data_aggregator/web/.vercel/
data_aggregator/web/out/
data_aggregator/web/test-results/
data_aggregator/web/playwright-report/
data_aggregator/design/**/.thumbnail
data_aggregator/design/*.zip
__pycache__/
.pytest_cache/
.DS_Store
