    "cli": "tsx src/cli.ts",
    "preflight": "tsx src/cli.ts preflight",
    "browser:prepare": "tsx src/cli.ts browser-prepare",
    "browser:smoke": "tsx src/cli.ts browser-smoke",
    "browser:run": "tsx src/cli.ts browser-run",
    "browser:headed": "tsx src/cli.ts browser-smoke",
    "browser:headed:run": "tsx src/cli.ts browser-headed-run",
    "browser:command": "tsx src/cli.ts browser-command",
    "gmail:auth": "tsx src/cli.ts gmail-auth",
