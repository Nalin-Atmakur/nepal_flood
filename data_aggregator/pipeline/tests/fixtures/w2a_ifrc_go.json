69777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> </span></p>\r\n</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</div>\r\n<div class=\"ListContainerWrapper SCXW107300033 BCX8\">\r\n<ul>\r\n<li style=\"list-style-type: none;\">\r\n<ul class=\"BulletListStyle2 SCXW107300033 BCX8\" role=\"list\">\r\n<li class=\"OutlineElement Ltr SCXW107300033 BCX8\" role=\"listitem\" aria-setsize=\"-1\" data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"2\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Rasuwagadhi area</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,1440],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> </span></p>\r\n</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</div>\r\n<div class=\"ListContainerWrapper SCXW107300033 BCX8\">\r\n<ul>\r\n<li style=\"list-style-type: none;\">\r\n<ul class=\"BulletListStyle2 SCXW107300033 BCX8\" role=\"list\">\r\n<li class=\"OutlineElement Ltr SCXW107300033 BCX8\" role=\"listitem\" aria-setsize=\"-1\" data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"2\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Syabrubesi settlement</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,1440],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> </span></p>\r\n</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</div>\r\n<div class=\"ListContainerWrapper SCXW107300033 BCX8\">\r\n<ul>\r\n<li style=\"list-style-type: none;\">\r\n<ul class=\"BulletListStyle2 SCXW107300033 BCX8\" role=\"list\">\r\n<li class=\"OutlineElement Ltr SCXW107300033 BCX8\" role=\"listitem\" aria-setsize=\"-1\" data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"2\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Multiple hydropower projects, including damage to the Chilime Hydropower Project</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,1440],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> </span></p>\r\n</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</div>\r\n<div class=\"ListContainerWrapper SCXW107300033 BCX8\">\r\n<ul>\r\n<li style=\"list-style-type: none;\">\r\n<ul class=\"BulletListStyle2 SCXW107300033 BCX8\" role=\"list\">\r\n<li class=\"OutlineElement Ltr SCXW107300033 BCX8\" role=\"listitem\" aria-setsize=\"-1\" data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"2\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Three Nepal Police facilities: Timure Area Police Office, Rasuwagadhi Police Post, and Syabrubesi Police Post</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,1440],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> </span></p>\r\n</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</div>\r\n<div class=\"ListContainerWrapper SCXW107300033 BCX8\">\r\n<ul class=\"BulletListStyle1 SCXW107300033 BCX8\" role=\"list\">\r\n<li class=\"OutlineElement Ltr SCXW107300033 BCX8\" role=\"listitem\" aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Initial reports indicate that </span><span class=\"NormalTextRun SCXW107300033 BCX8\">30-40 drivers may be missing</span><span class=\"NormalTextRun SCXW107300033 BCX8\">, although verification is ongoing.</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,720],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> Extent of causaulities and missing persons remain unclear.</span></p>\r\n</li>\r\n</ul>\r\n</div>\r\n<div class=\"OutlineElement Ltr SCXW107300033 BCX8\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Areas at Risk</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160}\"> </span></p>\r\n</div>\r\n<div class=\"OutlineElement Ltr SCXW107300033 BCX8\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">High-alert warnings have been issued for communities located along the </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Bhote Koshi and Trishuli rivers</span><span class=\"NormalTextRun SCXW107300033 BCX8\">, particularly in:</span> <span class=\"NormalTextRun SCXW107300033 BCX8\">Rasuwa</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,720],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\">, </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Nuwakot</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,720],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\">, </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Dhading, </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Gorkha, </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Chitwan.</span></p>\r\n</div>\r\n<div class=\"OutlineElement Ltr SCXW107300033 BCX8\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Residents living along riverbanks have been advised to move to safer locations and remain vigilant until further notice.</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160}\"> </span></p>\r\n</div>\r\n<div class=\"OutlineElement Ltr SCXW107300033 BCX8\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Transport and Access</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160}\"> </span></p>\r\n</div>\r\n<div class=\"ListContainerWrapper SCXW107300033 BCX8\">\r\n<ul class=\"BulletListStyle1 SCXW107300033 BCX8\" role=\"list\">\r\n<li class=\"OutlineElement Ltr SCXW107300033 BCX8\" role=\"listitem\" aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"5\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">Travel has been discouraged on: </span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,720],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Prithvi Highway, </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Galchhi-Nuwakot-Rasuwa-Syabrubesi Road, </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Muglin-Narayangadh Road, </span><span class=\"NormalTextRun SCXW107300033 BCX8\">Kathmandu Valley Traffic Police have reportedly halted vehicles heading toward Rasuwa and other affected districts.</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,720],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> </span></p>\r\n</li>\r\n</ul>\r\n</div>\r\n<div class=\"ListContainerWrapper SCXW107300033 BCX8\">\r\n<ul class=\"BulletListStyle1 SCXW107300033 BCX8\" role=\"list\">\r\n<li class=\"OutlineElement Ltr SCXW107300033 BCX8\" role=\"listitem\" aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"5\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\">\r\n<p class=\"Paragraph SCXW107300033 BCX8\" lang=\"EN-US\"><span class=\"NormalTextRun SCXW107300033 BCX8\">People working, fishing, or conducting activities near the Trishuli River have been ordered to leave the river corridor immediately.</span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,720],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\"> </span><span class=\"EOP Selected SCXW107300033 BCX8\" data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:0,&quot;335551620&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;469777462&quot;:[0,720],&quot;469777927&quot;:[0,0],&quot;469777928&quot;:[1,1]}\">Initial data are not available due to communication cut off in affected areas, will be updated in next field report.</span></p>\r\n</li>\r\n</ul>\r\n</div>", "name": "Nepal: Rasuwa Flash Flood, 2026", "translation_module_original_language": "en"}